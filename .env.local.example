# ============================================================
# Portal SGC - Grupo Falpat SRL
# Copiar este archivo como .env.local y completar los valores.
# .env.local NO se sube al repositorio.
# ============================================================

# Secreto para firmar la sesion y los enlaces temporales de archivos.
# Minimo 16 caracteres. Generar uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sin esta variable la app funciona en desarrollo con un secreto de prueba,
# pero en produccion (Vercel) es obligatoria.
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Persistencia de datos y archivos en GitHub (obligatorio en produccion).
# Crear un token fine-grained con permiso "Contents: Read and write"
# sobre el repositorio del portal.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=ssaavedra1969-png/Cetificacion

# Rama donde se guardan data/*.json y la carpeta documentos/.
# Por defecto: main
# GITHUB_BRANCH=main
